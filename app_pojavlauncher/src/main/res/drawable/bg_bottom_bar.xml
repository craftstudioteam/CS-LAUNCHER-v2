<?xml version="1.0" encoding="utf-8"?>
<!-- bg_bottom_bar.xml — Modern glassmorphism bar at bottom of right pane -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Semi-transparent for glass effect -->
    <solid android:color="#D9121212" />
    <!-- Subtle top border for depth -->
    <stroke android:width="1dp" android:color="#26FFFFFF" />
    <corners android:radius="16dp" />
</shape>