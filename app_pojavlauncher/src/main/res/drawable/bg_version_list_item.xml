<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/neon_green_dim">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/card_bg_pressed" />
                    <stroke android:width="1dp" android:color="@color/stroke_neon" />
                </shape>
            </item>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/card_bg_pressed" />
                    <stroke android:width="2dp" android:color="@color/neon_green" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/card_bg" />
                    <stroke android:width="1dp" android:color="@color/stroke_neon" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
