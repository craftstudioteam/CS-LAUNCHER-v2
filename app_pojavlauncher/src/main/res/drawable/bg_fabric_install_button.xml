<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled state -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1A2035" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#00B8A2"
                        android:centerColor="#0066CC"
                        android:endColor="#5B21B6"
                        android:type="linear" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal enabled state -->
    <item>
        <layer-list>
            <!-- Shadow / glow layer -->
            <item
                android:left="4dp"
                android:right="4dp"
                android:bottom="0dp"
                android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#4400E5CC" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- Main button -->
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#00E5CC"
                        android:centerColor="#0085E5"
                        android:endColor="#7C3AED"
                        android:type="linear" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
