<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/app/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ── HEADER ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mod_store_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_header"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/mod_store_back"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginStart="@dimen/padding_medium"
            android:layout_marginTop="@dimen/padding_medium"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white"
            android:contentDescription="@string/global_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/neon_green" />

        <TextView
            android:id="@+id/mod_store_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_moderate"
            android:layout_marginTop="@dimen/padding_medium"
            android:text="Download Mods"
            android:textColor="@color/text_primary_light"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mod_store_back"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/search_mod_filter"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginEnd="@dimen/padding_medium"
            android:background="@drawable/background_card"
            android:padding="8dp"
            android:src="@drawable/ic_filter"
            app:layout_constraintBottom_toBottomOf="@id/search_mod_edittext"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/search_mod_edittext"
            app:tint="@color/neon_green" />

        <EditText
            android:id="@+id/search_mod_edittext"
            android:layout_width="0dp"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginStart="@dimen/padding_medium"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/background_card"
            android:hint="Search mods..."
            android:paddingStart="40dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:textColor="@color/text_primary_light"
            android:textColorHint="@color/text_secondary_dim"
            android:textSize="14sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            app:layout_constraintEnd_toStartOf="@id/search_mod_filter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mod_store_title" />

        <!-- Search icon inside edit text -->
        <ImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:src="@drawable/ic_search"
            app:layout_constraintBottom_toBottomOf="@id/search_mod_edittext"
            app:layout_constraintStart_toStartOf="@id/search_mod_edittext"
            app:layout_constraintTop_toTopOf="@id/search_mod_edittext"
            app:tint="@color/text_secondary_dim" />



    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/search_mod_progressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:progressTint="@color/neon_green"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/mod_store_header" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_mod_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_mod_progressbar" />

    <TextView
        android:id="@+id/search_mod_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary_dim"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mod_store_header"
        tools:text="No results found." />

</androidx.constraintlayout.widget.ConstraintLayout>