<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:id="@+id/fragment_profile_editor_root"
    android:orientation="vertical"
    android:animateLayoutChanges="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="true"
        android:scrollbarThumbVertical="#00FF41"
        android:scrollbarSize="3dp"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:background="@drawable/bg_profile_editor_card_new"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:paddingBottom="40dp"
            android:animateLayoutChanges="true">

            <!-- ── PROFILE INFORMATION ── -->
            <FrameLayout
                android:id="@+id/profile_icon_container"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_profile_icon_glow"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/vprof_editor_profile_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    tools:src="@tools:sample/avatars" />
            </FrameLayout>

            <ImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:src="@drawable/ic_edit_profile"
                android:background="@drawable/background_icon_edit_new"
                android:padding="3dp"
                app:layout_constraintBottom_toBottomOf="@+id/profile_icon_container"
                app:layout_constraintEnd_toEndOf="@+id/profile_icon_container"
                android:elevation="4dp"/>

            <!-- Profile Name -->
            <TextView
                android:id="@+id/vprof_editor_profile_name_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profiles_profile_name"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp"
                app:layout_constraintBottom_toTopOf="@+id/vprof_editor_profile_name"
                app:layout_constraintStart_toStartOf="@+id/vprof_editor_profile_name" />

            <EditText
                android:id="@+id/vprof_editor_profile_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/background_line_new"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:ems="10"
                android:hint="@string/unnamed"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                app:layout_constraintTop_toBottomOf="@id/profile_icon_container" />

            <!-- Version -->
            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profiles_profile_version"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp"
                app:layout_constraintBottom_toTopOf="@+id/vprof_editor_version_spinner"
                app:layout_constraintStart_toStartOf="@+id/vprof_editor_version_spinner" />

            <TextView
                android:id="@+id/vprof_editor_version_spinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/background_line_new"
                android:hint="@string/version_select_hint"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@+id/vprof_editor_version_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_profile_name" />

            <Button
                android:id="@+id/vprof_editor_version_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="0dp"
                android:minHeight="0dp"
                android:text="@string/global_select"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/bg_neon_button"
                android:stateListAnimator="@null"
                app:layout_constraintBottom_toBottomOf="@+id/vprof_editor_version_spinner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/vprof_editor_version_spinner" />

            <!-- Custom Path -->
            <TextView
                android:id="@+id/vprof_editor_beginPathView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Custom Path"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_version_spinner" />

            <TextView
                android:id="@+id/vprof_editor_path"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/background_line_new"
                android:ems="10"
                android:maxLines="2"
                android:ellipsize="end"
                android:hint=".minecraft"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/vprof_editor_path_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_beginPathView" />

            <Button
                android:id="@+id/vprof_editor_path_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingHorizontal="18dp"
                android:minHeight="0dp"
                android:text="@string/global_select"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/bg_neon_button"
                android:stateListAnimator="@null"
                app:layout_constraintBottom_toBottomOf="@id/vprof_editor_path"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/vprof_editor_path" />

            <!-- ── RUNTIME SETTINGS DIVIDER ── -->
            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/divider_neon_gradient"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_path"/>

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/pedit_java_runtime"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider1" />

            <Spinner
                android:id="@+id/vprof_editor_spinner_runtime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/background_line_new"
                android:paddingHorizontal="10dp"
                android:popupBackground="#1A1A1A"
                app:layout_constraintTop_toBottomOf="@+id/textView2" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_8sdp"
                android:paddingHorizontal="@dimen/_10sdp"
                android:rotation="180"
                android:src="@drawable/spinner_arrow"
                app:tint="#00FF41"
                app:layout_constraintBottom_toBottomOf="@id/vprof_editor_spinner_runtime"
                app:layout_constraintEnd_toEndOf="@id/vprof_editor_spinner_runtime"
                app:layout_constraintTop_toTopOf="@id/vprof_editor_spinner_runtime" />

            <!-- Renderer -->
            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/pedit_renderer"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_spinner_runtime" />

            <Spinner
                android:id="@+id/vprof_editor_profile_renderer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/background_line_new"
                android:dropDownWidth="match_parent"
                android:paddingHorizontal="10dp"
                android:popupBackground="#1A1A1A"
                app:layout_constraintTop_toBottomOf="@+id/textView3" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_8sdp"
                android:paddingHorizontal="@dimen/_10sdp"
                android:rotation="180"
                android:src="@drawable/spinner_arrow"
                app:tint="#00FF41"
                app:layout_constraintBottom_toBottomOf="@id/vprof_editor_profile_renderer"
                app:layout_constraintEnd_toEndOf="@id/vprof_editor_profile_renderer"
                app:layout_constraintTop_toTopOf="@id/vprof_editor_profile_renderer" />

            <!-- JVM Args -->
            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/pvc_jvmArgs"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_profile_renderer" />

            <EditText
                android:id="@+id/vprof_editor_jre_args"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/background_line_new"
                android:ems="10"
                android:hint="@string/use_global_default"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/textView6" />

            <!-- Default Control -->
            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/default_control"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_jre_args" />

            <TextView
                android:id="@+id/vprof_editor_ctrl_spinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/background_line_new"
                android:hint="@string/use_global_default"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/vprof_editor_ctrl_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView7" />

            <Button
                android:id="@+id/vprof_editor_ctrl_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingHorizontal="18dp"
                android:minHeight="0dp"
                android:text="@string/global_select"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/bg_neon_button"
                android:stateListAnimator="@null"
                app:layout_constraintBottom_toBottomOf="@id/vprof_editor_ctrl_spinner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/vprof_editor_ctrl_spinner" />

            <!-- ── MODS SECTION ── -->
            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/divider_neon_gradient"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_ctrl_spinner"/>

            <TextView
                android:id="@+id/vprof_editor_mods_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Mods"
                android:textAllCaps="true"
                android:textSize="13sp"
                android:textColor="#00FF41"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/vprof_editor_mods_import"
                app:layout_constraintTop_toBottomOf="@+id/divider2" />

            <ImageButton
                android:id="@+id/vprof_editor_mods_import"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_icon_button_neon"
                android:src="@drawable/ic_add"
                android:padding="6dp"
                app:tint="#00FF41"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/vprof_editor_mods_add"
                app:layout_constraintTop_toTopOf="@+id/vprof_editor_mods_header"
                app:layout_constraintBottom_toBottomOf="@+id/vprof_editor_mods_header" />

            <ImageButton
                android:id="@+id/vprof_editor_mods_add"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_icon_button_neon"
                android:src="@drawable/ic_folder"
                android:padding="6dp"
                app:tint="#00FF41"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/vprof_editor_mods_header"
                app:layout_constraintBottom_toBottomOf="@+id/vprof_editor_mods_header" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vprof_editor_mods_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_mods_header" />

            <TextView
                android:id="@+id/vprof_editor_mods_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/manage_mods_empty"
                android:textColor="#888888"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/bg_empty_state"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_mods_header" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/vprof_editor_mods_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="vprof_editor_mods_recycler,vprof_editor_mods_empty" />

            <!-- ── RESOURCE PACKS SECTION ── -->
            <View
                android:id="@+id/divider3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/divider_neon_gradient"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_mods_barrier"/>

            <TextView
                android:id="@+id/vprof_editor_resource_packs_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/mcl_button_resource_packs"
                android:textAllCaps="true"
                android:textSize="13sp"
                android:textColor="#00FF41"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/vprof_editor_resource_packs_import"
                app:layout_constraintTop_toBottomOf="@+id/divider3" />

            <ImageButton
                android:id="@+id/vprof_editor_resource_packs_import"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_icon_button_neon"
                android:src="@drawable/ic_add"
                android:padding="6dp"
                app:tint="#00FF41"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/vprof_editor_resource_packs_folder"
                app:layout_constraintTop_toTopOf="@+id/vprof_editor_resource_packs_header"
                app:layout_constraintBottom_toBottomOf="@+id/vprof_editor_resource_packs_header" />

            <ImageButton
                android:id="@+id/vprof_editor_resource_packs_folder"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_icon_button_neon"
                android:src="@drawable/ic_folder"
                android:padding="6dp"
                app:tint="#00FF41"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/vprof_editor_resource_packs_header"
                app:layout_constraintBottom_toBottomOf="@+id/vprof_editor_resource_packs_header" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vprof_editor_resource_packs_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_resource_packs_header" />

            <TextView
                android:id="@+id/vprof_editor_resource_packs_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No resource packs installed."
                android:textColor="#888888"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/bg_empty_state"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_resource_packs_header" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/vprof_editor_resource_packs_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="vprof_editor_resource_packs_recycler,vprof_editor_resource_packs_empty" />

            <!-- ── SHADER PACKS SECTION ── -->
            <View
                android:id="@+id/divider4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/divider_neon_gradient"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_resource_packs_barrier"/>

            <TextView
                android:id="@+id/vprof_editor_shader_packs_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/mcl_button_shader_packs"
                android:textAllCaps="true"
                android:textSize="13sp"
                android:textColor="#00FF41"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/vprof_editor_shader_packs_import"
                app:layout_constraintTop_toBottomOf="@+id/divider4" />

            <ImageButton
                android:id="@+id/vprof_editor_shader_packs_import"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_icon_button_neon"
                android:src="@drawable/ic_add"
                android:padding="6dp"
                app:tint="#00FF41"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/vprof_editor_shader_packs_folder"
                app:layout_constraintTop_toTopOf="@+id/vprof_editor_shader_packs_header"
                app:layout_constraintBottom_toBottomOf="@+id/vprof_editor_shader_packs_header" />

            <ImageButton
                android:id="@+id/vprof_editor_shader_packs_folder"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_icon_button_neon"
                android:src="@drawable/ic_folder"
                android:padding="6dp"
                app:tint="#00FF41"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/vprof_editor_shader_packs_header"
                app:layout_constraintBottom_toBottomOf="@+id/vprof_editor_shader_packs_header" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vprof_editor_shader_packs_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_shader_packs_header" />

            <TextView
                android:id="@+id/vprof_editor_shader_packs_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No shader packs installed."
                android:textColor="#888888"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/bg_empty_state"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/vprof_editor_shader_packs_header" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/vprof_editor_shader_packs_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="vprof_editor_shader_packs_recycler,vprof_editor_shader_packs_empty" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="#0F0F0F"
        android:elevation="8dp">

        <com.kdt.mcgui.MineButton
            android:id="@+id/vprof_editor_save_button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/global_save"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_save_button_neon"
            android:stateListAnimator="@null"
            android:layout_marginEnd="8dp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/vprof_editor_delete_button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
