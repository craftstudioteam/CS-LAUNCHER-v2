<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <!-- HIDDEN PRESERVED IDs FOR BACKEND LOGIC -->
    <Spinner android:id="@+id/fabric_installer_game_ver_spinner" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <Spinner android:id="@+id/fabric_installer_loader_ver_spinner" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    
    <ViewFlipper
        android:id="@+id/fabric_step_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inAnimation="@anim/slide_in_up">

        <!-- ============================================== -->
        <!-- SCREEN 1: MINECRAFT VERSIONS                   -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Sticky Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#1A1A1A"
                android:elevation="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Select Game Version"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <CheckBox
                        android:id="@+id/fabric_installer_only_stable_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Stable Only"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="14sp"
                        android:checked="false"
                        android:buttonTint="?attr/colorAccent"/>
                </RelativeLayout>

            </LinearLayout>

            <!-- Scrollable List -->
            <ListView
                android:id="@+id/fabric_game_ver_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="20dp" />
        </LinearLayout>


        <!-- ============================================== -->
        <!-- SCREEN 2: LOADER & INSTALL                     -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Sticky Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:background="#1A1A1A"
                android:elevation="8dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/fabric_step2_back_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="?attr/colorTextPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Select Loader"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <!-- Badge for selected game version -->
                <TextView
                    android:id="@+id/fabric_installer_label_loader_ver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_selected_version_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Loader List -->
            <ListView
                android:id="@+id/fabric_loader_ver_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="20dp" />

            <!-- Fixed Bottom Action Bar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:elevation="16dp"
                android:padding="20dp">

                <!-- Hidden IDs to preserve logic -->
                <Button android:id="@+id/fabric_step3_back_btn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

                <Button
                    android:id="@+id/fabric_installer_start_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="INSTALL"
                    android:background="@drawable/bg_install_button_primary"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <ProgressBar
                    android:id="@+id/fabric_installer_progress_bar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/fabric_installer_retry_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">
                    <Button
                        android:id="@+id/fabric_installer_retry_button"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="@string/global_retry"
                        android:background="@drawable/bg_version_item_normal"
                        android:textColor="?attr/colorTextPrimary" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ViewFlipper>
</androidx.constraintlayout.widget.ConstraintLayout>
