<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Hero background image (Corrected asset) -->
    <ImageView
        android:id="@+id/iv_hero_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_hero_minecraft"
        android:contentDescription="Hero background" />

    <!-- Dark gradient scrim for text readability -->
    <View
        android:id="@+id/hero_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_hero_scrim" />

    <!-- Custom wallpaper — invisible by default, loaded dynamically -->
    <ImageView
        android:id="@+id/right_pane_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Center Logo -->
    <ImageView
        android:id="@+id/iv_center_logo"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_100sdp"
        android:src="@drawable/bg_hero_minecraft"
        android:scaleType="fitCenter"
        android:contentDescription="Launcher Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5" />


</androidx.constraintlayout.widget.ConstraintLayout>