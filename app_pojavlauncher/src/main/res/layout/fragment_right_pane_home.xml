<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Hero background image (Corrected asset) -->
    <ImageView
        android:id="@+id/iv_hero_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_hero_minecraft"
        android:contentDescription="Hero background" />

    <!-- Dark gradient scrim for text readability -->
    <View
        android:id="@+id/hero_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_hero_scrim" />

    <!-- Custom wallpaper — invisible by default, loaded dynamically -->
    <ImageView
        android:id="@+id/right_pane_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Center Logo -->
    <ImageView
        android:id="@+id/iv_center_logo"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_100sdp"
        android:src="@drawable/bg_hero_minecraft"
        android:scaleType="fitCenter"
        android:contentDescription="Launcher Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35" />

    <!-- "About Launcher" Text Block -->
    <TextView
        android:id="@+id/tv_about_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="About Launcher"
        android:textSize="@dimen/_18ssp"
        android:textStyle="bold"
        android:textColor="@color/text_primary_white"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/iv_center_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_12sdp" />

    <TextView
        android:id="@+id/tv_about_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Welcome to CS Launcher v2. This launcher is designed to provide a modern and customizable experience for your Minecraft adventures. More detailed information will be available here soon."
        android:textSize="@dimen/_11ssp"
        android:textColor="@color/text_secondary_light"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/_2sdp"
        android:layout_marginStart="@dimen/_40sdp"
        android:layout_marginEnd="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintTop_toBottomOf="@id/tv_about_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>