<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/install_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E1E"
        android:paddingHorizontal="@dimen/padding_medium">

        <ImageButton
            android:id="@+id/install_back_button"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white"
            android:contentDescription="@string/global_back"
            app:tint="@color/neon_green" />

        <TextView
            android:id="@+id/install_topbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/padding_moderate"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Install Mod" />

    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/install_scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_72sdp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_16sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_16sdp">

            <!-- Header: Icon + Title + Version Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/install_mod_icon"
                    android:layout_width="@dimen/_72sdp"
                    android:layout_height="@dimen/_72sdp"
                    android:background="@drawable/background_image_rounded"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    tools:src="@mipmap/ic_launcher_foreground" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/install_mod_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_18ssp"
                        android:textStyle="bold"
                        tools:text="Sodium" />

                    <TextView
                        android:id="@+id/install_selected_version_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_4sdp"
                        android:textColor="@color/neon_green"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_version_badge"
                        tools:text="Fabric 1.21.1" />

                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/_16sdp"
                android:background="#333333" />

            <!-- Description Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <!-- Full Description -->
            <TextView
                android:id="@+id/install_full_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:textColor="#B0B0B0"
                android:textSize="@dimen/_13ssp"
                android:lineSpacingExtra="3dp"
                tools:text="Sodium is a modern rendering engine and graphical optimization mod for Minecraft. It greatly improves frame rates and reduces stuttering while maintaining parity with the vanilla game's look and feel." />

            <!-- Changelog placeholder -->
            <TextView
                android:id="@+id/install_changelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:textColor="#909090"
                android:textSize="@dimen/_12ssp"
                android:lineSpacingExtra="2dp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Install Button -->
    <FrameLayout
        android:id="@+id/install_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_bottom_bar"
        android:elevation="8dp"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp">

        <Button
            android:id="@+id/install_button"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:background="@drawable/background_download_button_enabled"
            android:enabled="true"
            android:stateListAnimator="@null"
            android:text="INSTALL NOW"
            android:textAllCaps="true"
            android:textColor="@color/neon_green"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />

    </FrameLayout>

</FrameLayout>
