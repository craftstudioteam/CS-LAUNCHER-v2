<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:animateLayoutChanges="true">

    <!-- ═══════════════════════════════════════ -->
    <!-- ✦ TOP BAR (Compact Horizontal)         -->
    <!-- ═══════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cursor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:background="@drawable/bg_top_bar_gradient"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/cursor_back_button"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:background="@drawable/bg_icon_button_round"
            android:src="@drawable/ic_arrow_back_white"
            android:padding="8dp"
            app:tint="#00FF41"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/cursor_back_button"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="3dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_neon_indicator_small"
                android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cursor Customization"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Design your style"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:letterSpacing="0.05"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Modern Tab Switcher -->
        <LinearLayout
            android:id="@+id/cursor_tab_container"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/bg_tab_container"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tab_import"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Import"
                android:background="@drawable/bg_tab_active"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/tab_create" android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tab_active"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Create"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/tab_collection"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Collection"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════ -->
    <!-- ✦ IMPORT PANEL (Mobile Optimized)      -->
    <!-- ═══════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/panel_import"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#050505"
        android:visibility="gone"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp">

            <!-- Left: Import Button Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_section_card"
                android:padding="16dp"
                android:minHeight="200dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_badge_neon"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="📁"
                        android:textSize="22sp"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Import Cursor"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PNG / GIF supported"
                    android:textColor="#666666"
                    android:textSize="10sp"
                    android:layout_marginBottom="16dp"/>

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_import_png"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="CHOOSE FILE"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:background="@drawable/bg_save_button"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- Right: Settings Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:background="@drawable/bg_section_card"
                android:padding="14dp">

                <!-- Cursor Scale -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_neon_dot_small"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CURSOR SCALE"
                        android:textColor="#00FF41"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_cursor_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:max="300"
                    android:progress="100"
                    android:progressTint="#00FF41"
                    android:thumbTint="#00FF41"
                    android:progressBackgroundTint="#2A2A2A"/>

                <!-- Glow Intensity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_neon_dot_small"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GLOW INTENSITY"
                        android:textColor="#00FF41"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_glow_strength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#00FF41"
                    android:thumbTint="#00FF41"
                    android:progressBackgroundTint="#2A2A2A"/>

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_apply_import"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:text="APPLY &amp; SAVE"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:background="@drawable/bg_save_button"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════ -->
    <!-- ✦ COLLECTION PANEL                     -->
    <!-- ═══════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/panel_collection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#050505"
        android:padding="8dp"
        android:clipToPadding="false"
        android:visibility="gone"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>
