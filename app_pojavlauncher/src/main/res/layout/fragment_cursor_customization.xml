<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cursor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:background="@color/bg_header"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/cursor_back_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/padding_medium"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/cursor_tab_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tab_import"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/padding_medium"
                android:text="Import"
                android:textColor="@color/text_secondary_light"
                android:textSize="@dimen/_12ssp" />

            <TextView
                android:id="@+id/tab_create"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/padding_medium"
                android:text="Create"
                android:textColor="@color/neon_green"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_my_cursors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/padding_medium"
                android:text="Collection"
                android:textColor="@color/text_secondary_light"
                android:textSize="@dimen/_12ssp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CREATE MODE PANEL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panel_create"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar">

        <!-- Preview Card -->
        <FrameLayout
            android:id="@+id/create_preview_card"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="@dimen/padding_medium"
            android:background="@drawable/background_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVE PREVIEW"
                android:gravity="center"
                android:textSize="10sp"
                android:textColor="@color/neon_green"
                android:layout_marginTop="8dp"/>

            <ImageView
                android:id="@+id/create_live_preview"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mouse_pointer" />
        </FrameLayout>

        <!-- Canvas -->
        <net.kdt.pojavlaunch.customcontrols.mouse.CursorDesignerView
            android:id="@+id/cursor_designer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="@dimen/padding_small"
            app:layout_constraintBottom_toTopOf="@id/create_bottom_panel"
            app:layout_constraintTop_toBottomOf="@id/create_preview_card" />

        <!-- Tools and Colors -->
        <LinearLayout
            android:id="@+id/create_bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#222222"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Top bar (Undo/Redo/Clear) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_small">
                <ImageButton android:id="@+id/btn_undo" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_undo" android:background="?attr/selectableItemBackgroundBorderless"/>
                <ImageButton android:id="@+id/btn_redo" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_redo" android:background="?attr/selectableItemBackgroundBorderless"/>
                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                <ImageButton android:id="@+id/btn_clear_canvas" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_menu_delete_forever" android:background="?attr/selectableItemBackgroundBorderless"/>
                <ImageButton android:id="@+id/btn_save_creation" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_edit_profile" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@color/neon_green"/>
            </LinearLayout>

            <!-- Colors -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:scrollbars="none"
                android:paddingHorizontal="8dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:id="@+id/color_white" android:layout_width="32dp" android:layout_height="32dp" android:background="#FFFFFF" android:layout_margin="8dp"/>
                    <View android:id="@+id/color_neon" android:layout_width="32dp" android:layout_height="32dp" android:background="#A6FF3D" android:layout_margin="8dp"/>
                    <View android:id="@+id/color_red" android:layout_width="32dp" android:layout_height="32dp" android:background="#FF0000" android:layout_margin="8dp"/>
                    <View android:id="@+id/color_blue" android:layout_width="32dp" android:layout_height="32dp" android:background="#0000FF" android:layout_margin="8dp"/>
                    <View android:id="@+id/color_black" android:layout_width="32dp" android:layout_height="32dp" android:background="#000000" android:layout_margin="8dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Tool buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center">
                <ImageButton android:id="@+id/btn_tool_pencil" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/ic_edit_profile" android:background="?attr/selectableItemBackground" android:backgroundTint="@color/neon_green_dim"/>
                <ImageButton android:id="@+id/btn_tool_fill" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/ic_fill" android:background="?attr/selectableItemBackground"/>
                <ImageButton android:id="@+id/btn_tool_eraser" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/ic_menu_delete_forever" android:background="?attr/selectableItemBackground"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- IMPORT PANEL -->
    <LinearLayout
        android:id="@+id/panel_import"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar">

        <com.kdt.mcgui.MineButton
            android:id="@+id/btn_import_png"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IMPORT PNG IMAGE"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/background_card"
            android:padding="@dimen/padding_medium">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GLOBAL SCALE"
                android:textColor="@color/neon_green"
                android:textSize="10sp"/>
                
            <SeekBar
                android:id="@+id/seek_cursor_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="300"
                android:progress="100"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GLOW STRENGTH"
                android:textColor="@color/neon_green"
                android:textSize="10sp"/>

            <SeekBar
                android:id="@+id/seek_glow_strength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"/>
        </LinearLayout>
    </LinearLayout>

    <!-- COLLECTION PANEL -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/panel_collection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="@dimen/padding_medium"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>
