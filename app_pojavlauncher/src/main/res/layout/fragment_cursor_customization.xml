<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:animateLayoutChanges="true">

    <!-- ═══════════════════════════════════════ -->
    <!-- ✦ TOP BAR                              -->
    <!-- ═══════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cursor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:background="@drawable/bg_top_bar_gradient"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/cursor_back_button"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:background="@drawable/bg_icon_button_round"
            android:src="@drawable/ic_arrow_back_white"
            android:padding="8dp"
            app:tint="#00FF41"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CURSOR CUSTOMIZATION"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cursor_back_button"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════ -->
    <!-- ✦ SCROLLABLE CONTENT                   -->
    <!-- ═══════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ═══════════════════════════════════════ -->
            <!-- ✦ CURRENT CURSOR PREVIEW              -->
            <!-- ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT PREVIEW"
                android:textColor="#888888"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"/>

            <FrameLayout
                android:id="@+id/cursor_preview_container"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_cursor_preview"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/cursor_preview_image"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mouse_pointer"
                    android:padding="6dp"
                    android:background="@drawable/bg_preview_box"
                    android:contentDescription="Current cursor preview"/>

                <TextView
                    android:id="@+id/cursor_preview_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:text="DEFAULT"
                    android:textColor="#00FF41"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_size_chip"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_margin="6dp"/>
            </FrameLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- ✦ UPLOAD SECTION                       -->
            <!-- ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INPUT YOUR CURSOR"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IMPORT AN IMAGE (PNG) OR GIF (ANIMATED) FILE FROM YOUR GALLERY TO SET YOUR CUSTOM CURSOR."
                android:textColor="#666666"
                android:textSize="9sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:id="@+id/upload_zone"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_dashed_border"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_upload"
                    android:alpha="0.5"
                    app:tint="#00FF41"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to upload your cursor"
                    android:textColor="#888888"
                    android:textSize="11sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PNG / GIF supported"
                    android:textColor="#555555"
                    android:textSize="9sp"/>

            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- ✦ CURSOR SETTINGS                      -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp"
                android:weightSum="2">

                <!-- UPLOAD IMAGE/GIF Button -->
                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_import_png"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="0.5"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_green_gradient_button"
                    android:text="UPLOAD IMAGE/GIF"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:drawableStart="@drawable/ic_gif"
                    android:drawablePadding="6dp"
                    android:stateListAnimator="@null"/>

            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- ✦ CURSOR SCALE + GLOW                  -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <!-- Cursor Scale -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CURSOR SCALE"
                        android:textColor="#00FF41"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/scale_value_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_cursor_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:max="300"
                    android:progress="100"
                    android:progressTint="#00FF41"
                    android:thumbTint="#00FF41"
                    android:progressBackgroundTint="#2A2A2A"/>

                <!-- Glow Intensity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GLOW INTENSITY"
                        android:textColor="#00FF41"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/glow_value_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_glow_strength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#00FF41"
                    android:thumbTint="#00FF41"
                    android:progressBackgroundTint="#2A2A2A"/>

                <!-- Hotspot X -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HOTSPOT X"
                        android:textColor="#00FF41"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/hotspot_x_value_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 px"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_hotspot_x"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:max="128"
                    android:progress="0"
                    android:progressTint="#00FF41"
                    android:thumbTint="#00FF41"
                    android:progressBackgroundTint="#2A2A2A"/>

                <!-- Hotspot Y -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HOTSPOT Y"
                        android:textColor="#00FF41"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/hotspot_y_value_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 px"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_hotspot_y"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:max="128"
                    android:progress="0"
                    android:progressTint="#00FF41"
                    android:thumbTint="#00FF41"
                    android:progressBackgroundTint="#2A2A2A"/>

            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- ✦ SAVE BUTTON                          -->
            <!-- ═══════════════════════════════════════ -->
            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_save_cursor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_save_button_neon"
                android:text="SAVE CURSOR"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
