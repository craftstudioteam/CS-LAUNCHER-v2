<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark">

    <!-- ── TOP BAR ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cursor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:background="@color/bg_header"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/cursor_back_button"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/padding_medium"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_small"
            android:text="Cursor Customization"
            android:textColor="@color/text_primary_light"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/cursor_back_button"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/cursor_tab_container"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginEnd="@dimen/padding_medium"
            android:background="@drawable/background_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tab_import"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_medium"
                android:text="Import"
                android:textColor="@color/text_secondary_light"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/tab_create"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nav_item_active"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_medium"
                android:text="Create"
                android:textColor="@color/neon_green"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_collection"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="@dimen/padding_medium"
                android:text="Collection"
                android:textColor="@color/text_secondary_light"
                android:textSize="@dimen/_10ssp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── MAIN CONTENT AREA ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panel_create"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/tools_bottom_panel"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar">

        <!-- Left: Canvas -->
        <net.kdt.pojavlaunch.customcontrols.mouse.CursorDesignerView
            android:id="@+id/cursor_designer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@id/right_preview_panel"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Right: Preview Panel -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/right_preview_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/bg_sidebar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="0.3"
            app:layout_constraintStart_toEndOf="@id/cursor_designer">

            <TextView
                android:id="@+id/preview_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_medium"
                android:text="LIVE PREVIEW"
                android:textColor="@color/neon_green"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/preview_label">

                <!-- Large Preview -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Large (64px)"
                    android:textColor="@color/text_secondary_dim"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/preview_large"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/background_card"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mouse_pointer" />

                <!-- Medium Preview -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Medium (32px)"
                    android:textColor="@color/text_secondary_dim"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/preview_medium"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/background_card"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mouse_pointer" />

                <!-- Small Preview -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Small (16px)"
                    android:textColor="@color/text_secondary_dim"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/preview_small"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/background_card"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mouse_pointer" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── TOOLS BOTTOM PANEL ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tools_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_sidebar"
        android:paddingBottom="@dimen/padding_small"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Tool Selectors -->
        <LinearLayout
            android:id="@+id/tool_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/padding_small"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_tool_pencil"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_nav_item_active"
                android:src="@drawable/ic_edit_profile"
                app:tint="@color/neon_green" />

            <ImageButton
                android:id="@+id/btn_tool_eraser"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/background_card"
                android:src="@drawable/ic_menu_delete_forever"
                app:tint="@color/text_secondary_light" />

            <ImageButton
                android:id="@+id/btn_tool_fill"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/background_card"
                android:src="@drawable/ic_fill"
                app:tint="@color/text_secondary_light" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="8dp"
                android:background="@color/divider_color" />

            <ImageButton
                android:id="@+id/btn_undo"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_undo"
                app:tint="@color/text_secondary_light" />

            <ImageButton
                android:id="@+id/btn_redo"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_redo"
                app:tint="@color/text_secondary_light" />

            <ImageButton
                android:id="@+id/btn_clear_canvas"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu_delete_forever"
                app:tint="@color/text_secondary_dim" />

        </LinearLayout>

        <!-- Color Row -->
        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tool_container">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <View
                    android:id="@+id/color_white"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="6dp"
                    android:background="#FFFFFF" />

                <View
                    android:id="@+id/color_neon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="6dp"
                    android:background="#A6FF3D" />

                <View
                    android:id="@+id/color_red"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="6dp"
                    android:background="#FF4444" />

                <View
                    android:id="@+id/color_blue"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="6dp"
                    android:background="#4444FF" />

                <View
                    android:id="@+id/color_black"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="6dp"
                    android:background="#000000" />
                
                <View
                    android:id="@+id/color_orange"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="6dp"
                    android:background="#FFBB33" />

                <View
                    android:id="@+id/color_purple"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="6dp"
                    android:background="#AA66CC" />

            </LinearLayout>
        </HorizontalScrollView>

        <com.kdt.mcgui.MineButton
            android:id="@+id/btn_save_creation"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginEnd="@dimen/padding_medium"
            android:layout_marginBottom="@dimen/padding_small"
            android:text="SAVE CURSOR"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── IMPORT PANEL ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panel_import"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bg_launcher_dark"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar">

        <LinearLayout
            android:layout_width="@dimen/_300sdp"
            android:layout_height="wrap_content"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Import Custom Cursor"
                android:textColor="@color/neon_green"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_import_png"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="CHOOSE PNG / GIF IMAGE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURSOR SCALE"
                android:textColor="@color/text_secondary_dim"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/seek_cursor_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:max="300"
                android:progress="100"
                android:progressTint="@color/neon_green"
                android:thumbTint="@color/neon_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="GLOW INTENSITY"
                android:textColor="@color/text_secondary_dim"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/seek_glow_strength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/neon_green"
                android:thumbTint="@color/neon_green" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_apply_import"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="APPLY &amp; SAVE" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── COLLECTION PANEL ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/panel_collection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bg_launcher_dark"
        android:padding="@dimen/padding_medium"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>