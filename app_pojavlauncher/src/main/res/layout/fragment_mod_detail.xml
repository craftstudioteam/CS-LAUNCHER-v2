<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark"
>

    <!-- ── Top Navigation Bar ─────────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:background="@color/bg_header"
        android:elevation="4dp"
        android:translationZ="4dp">

        <ImageButton
            android:id="@+id/detail_back_button"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/padding_medium"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white"
            android:contentDescription="@string/global_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/neon_green" />

        <TextView
            android:id="@+id/detail_title_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_moderate"
            android:layout_marginEnd="@dimen/padding_medium"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary_light"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/detail_back_button"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Sodium" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Scrollable Content ─────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail_scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_60sdp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_16sdp"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_24sdp">

            <!-- Large Mod Icon -->
            <ImageView
                android:id="@+id/detail_mod_icon"
                android:layout_width="@dimen/_96sdp"
                android:layout_height="@dimen/_96sdp"
                android:background="@drawable/background_image_rounded"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@mipmap/ic_launcher_foreground" />

            <!-- Source Badge -->
            <ImageView
                android:id="@+id/detail_source_badge"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginTop="-8dp"
                android:layout_marginEnd="-8dp"
                android:background="@drawable/background_card"
                android:padding="2dp"
                app:layout_constraintEnd_toEndOf="@id/detail_mod_icon"
                app:layout_constraintTop_toTopOf="@id/detail_mod_icon"
                tools:src="@drawable/ic_modrinth" />

            <!-- Mod Title -->
            <TextView
                android:id="@+id/detail_mod_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:textColor="@color/text_primary_light"
                android:textSize="@dimen/_20ssp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/detail_mod_icon"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Sodium" />

            <!-- Author & Downloads -->
            <TextView
                android:id="@+id/detail_mod_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:textColor="@color/text_secondary_dim"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/detail_mod_icon"
                app:layout_constraintTop_toBottomOf="@id/detail_mod_title"
                tools:text="by jellysquid3 • 5M Downloads" />

            <!-- Divider -->
            <View
                android:id="@+id/detail_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@color/divider_color"
                app:layout_constraintTop_toBottomOf="@id/detail_mod_icon" />

            <!-- Full Description -->
            <TextView
                android:id="@+id/detail_full_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary_light"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintTop_toBottomOf="@id/detail_divider"
                tools:text="Sodium is a modern rendering engine and graphical optimization mod for Minecraft. It greatly improves frame rates, reduces stuttering, and fixes many graphical issues while maintaining parity with the vanilla game's look and feel. Sodium has extensive configuration options to fine-tune performance on a wide range of hardware configurations." />

            <!-- Version Selection Label -->
            <TextView
                android:id="@+id/detail_version_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24sdp"
                android:text="@string/detail_select_version"
                android:textColor="@color/text_primary_light"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/detail_full_description" />

            <!-- Version Dropdown / Spinner -->
            <LinearLayout
                android:id="@+id/detail_spinner_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/background_spinner_neon"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_2sdp"
                app:layout_constraintTop_toBottomOf="@id/detail_version_label">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/detail_version_spinner"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_42sdp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:paddingEnd="@dimen/_8sdp"
                    android:textColor="@color/text_primary_light"
                    android:textSize="@dimen/_13ssp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_spinner_arrow"
                    app:tint="@color/neon_green" />

            </LinearLayout>

            <!-- Error text for version loading -->
            <TextView
                android:id="@+id/detail_version_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:textColor="#FF4444"
                android:textSize="@dimen/_11ssp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/detail_spinner_container" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom Sticky Download Button ──────────────────────────── -->
    <FrameLayout
        android:id="@+id/detail_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_bottom_bar"
        android:elevation="8dp"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_10sdp">

        <Button
            android:id="@+id/detail_download_button"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:background="@drawable/background_download_button_disabled"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:text="@string/detail_select_version_first"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary_dim"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold" />

    </FrameLayout>

</FrameLayout>
