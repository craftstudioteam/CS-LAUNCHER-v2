<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_fastclient_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_fastclient_card">

            <!-- Main Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_56sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_14sdp"
                android:paddingEnd="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/iv_fastclient_icon"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:src="@drawable/ic_menu_settings"
                    android:tint="#39FF14"
                    android:scaleType="fitCenter"
                    android:contentDescription="FastClient" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/_12sdp">

                    <TextView
                        android:id="@+id/tv_fastclient_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FastClient"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_fastclient_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable fast client"
                        android:textColor="#AAAAAA"
                        android:textSize="@dimen/_11ssp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_fastclient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:thumbTint="#39FF14"
                    android:trackTint="#4D2A00" />

            </LinearLayout>

            <!-- Active version info (gone by default) -->
            <TextView
                android:id="@+id/tv_fastclient_version_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ FastClient v1.6.2 — Active"
                android:textColor="#39FF14"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:paddingStart="@dimen/_54sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
