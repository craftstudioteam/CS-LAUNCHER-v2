<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0F12"
    android:padding="16dp">

    <!-- ═══ HEADER SECTION ═══ -->
    <LinearLayout
        android:id="@+id/header_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:background="#39FF14"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skin Manager"
                android:textColor="#39FF14"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customize Appearance"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ SCROLLABLE CONTENT ═══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header_section"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 3D Player Preview Card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="@drawable/bg_fastclient_card"
                android:padding="8dp"
                android:layout_marginBottom="16dp">

                <android.opengl.GLSurfaceView
                    android:id="@+id/skin_preview_surface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Glow/neon overlay indicator -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3D PREVIEW (DRAG TO ROTATE)"
                    android:textColor="#39FF14"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#DD090D10"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"/>

                <!-- Camera Controls overlay -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#AA090D10"
                    android:padding="6dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btn_cam_reset"
                        android:layout_width="54dp"
                        android:layout_height="32dp"
                        android:text="R-CAM"
                        android:textSize="9sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_profile_button"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_cam_rot_reset"
                        android:layout_width="54dp"
                        android:layout_height="32dp"
                        android:text="R-ROT"
                        android:textSize="9sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_profile_button"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_cam_auto_rot"
                        android:layout_width="54dp"
                        android:layout_height="32dp"
                        android:text="AUTO"
                        android:textSize="9sp"
                        android:textColor="#39FF14"
                        android:background="@drawable/bg_profile_button"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_cam_zoom_in"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="+"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_profile_button"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_cam_zoom_out"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="-"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_profile_button" />
                </LinearLayout>
            </FrameLayout>

            <!-- 3. Skin Settings Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_fastclient_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SKIN CUSTOMIZATION"
                    android:textColor="#39FF14"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <!-- Skin Type Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Model Type"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_model_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alex (Slim Arms)"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp"
                        android:thumbTint="#39FF14"
                        android:trackTint="#333333" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_skin_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No custom skin selected"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"
                    android:maxLines="1"
                    android:ellipsize="middle"/>

                <!-- Skin buttons grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_change_skin"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="UPLOAD SKIN"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_profile_button_highlight" />

                    <Button
                        android:id="@+id/btn_remove_skin"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="REMOVE SKIN"
                        android:textColor="#FF3333"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_profile_button" />

                    <Button
                        android:id="@+id/btn_reset_default"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="RESET DEFAULT"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_profile_button" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. Cape Settings Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_fastclient_card"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAPE CUSTOMIZATION"
                    android:textColor="#39FF14"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_cape_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No custom cape selected"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"
                    android:maxLines="1"
                    android:ellipsize="middle"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_change_cape"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="UPLOAD CAPE"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_profile_button_highlight" />

                    <Button
                        android:id="@+id/btn_remove_cape"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="REMOVE CAPE"
                        android:textColor="#FF3333"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_profile_button" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Actions/Save Card -->
            <Button
                android:id="@+id/btn_save_skin_changes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="SAVE AND APPLY"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_profile_button_highlight"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
