<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark"
    android:padding="16dp">

    <!-- ═══ HEADER ═══ -->
    <LinearLayout
        android:id="@+id/header_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header_card"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_neon_indicator"
            android:layout_marginEnd="14dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skin &amp; Cape Manager"
                android:textColor="#00FF41"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configure local textures for offline play"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ MAIN CONTENT AREA ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/header_section"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="16dp">

        <!-- 3D Preview Panel (Left) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="@drawable/bg_fastclient_card"
            android:padding="4dp"
            android:layout_marginEnd="16dp">
            
            <!-- GLSurfaceView will be inserted here dynamically or initialized via XML -->
            <android.opengl.GLSurfaceView
                android:id="@+id/skin_preview_surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D PREVIEW"
                android:textColor="#00FF41"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#99000000"
                android:padding="6dp"
                android:layout_margin="8dp" />
        </FrameLayout>

        <!-- Actions Panel (Right) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_fastclient_card"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MODEL TYPE"
                android:textColor="#00FF41"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_model_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alex Model (Slim Arms)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:thumbTint="#00FF41"
                android:trackTint="#333333"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOCAL TEXTURES"
                android:textColor="#00FF41"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Change Skin Button -->
            <LinearLayout
                android:id="@+id/btn_change_skin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_profile_button"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Local Skin"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_skin_path"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select PNG from storage"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:ellipsize="middle" />
            </LinearLayout>

            <!-- Change Cape Button -->
            <LinearLayout
                android:id="@+id/btn_change_cape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_profile_button"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Local Cape"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cape_path"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select PNG from storage"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:ellipsize="middle" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
