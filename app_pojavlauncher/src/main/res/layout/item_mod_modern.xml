<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/background_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Mod icon -->
        <ImageView
            android:id="@+id/mod_thumbnail_imageview"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="@drawable/background_image_rounded"
            android:clipToOutline="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@mipmap/ic_launcher_foreground" />

        <!-- Mod name -->
        <TextView
            android:id="@+id/mod_title_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary_light"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/mod_source_imageview"
            app:layout_constraintStart_toEndOf="@+id/mod_thumbnail_imageview"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Sodium" />

        <!-- Mod author/version info -->
        <TextView
            android:id="@+id/mod_info_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/neon_green"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="@id/mod_title_textview"
            app:layout_constraintStart_toStartOf="@+id/mod_title_textview"
            app:layout_constraintTop_toBottomOf="@+id/mod_title_textview"
            tools:text="by jellysquid3 • 5M Downloads" />

        <!-- Mod description -->
        <TextView
            android:id="@+id/mod_body_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary_dim"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/mod_title_textview"
            app:layout_constraintTop_toBottomOf="@+id/mod_info_textview"
            tools:text="Modern rendering engine and graphical optimizations for Minecraft." />

        <!-- Source icon -->
        <ImageView
            android:id="@+id/mod_source_imageview"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_modrinth" />

        <!-- Extended Area (Hidden by default) -->
        <LinearLayout
            android:id="@+id/mod_extended_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/mod_thumbnail_imageview"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/mod_extended_version_spinner"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_card"
                    android:paddingStart="8dp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/mod_extended_select_version_button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="16dp"
                    android:text="Install"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/mod_extended_error_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Error loading versions"
                android:textColor="#FF4444"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Status Chip (e.g. Installed) -->
        <TextView
            android:id="@+id/mod_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nav_item_active"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="INSTALLED"
            android:textColor="@color/neon_green"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mod_thumbnail_imageview"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>