<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/background_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <!-- Mod icon with rounded corners -->
        <ImageView
            android:id="@+id/mod_thumbnail_imageview"
            android:layout_width="@dimen/_56sdp"
            android:layout_height="@dimen/_56sdp"
            android:scaleType="centerCrop"
            android:background="@drawable/background_image_rounded"
            android:clipToOutline="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@mipmap/ic_launcher_foreground" />

        <!-- Mod title (White, Bold) -->
        <TextView
            android:id="@+id/mod_title_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary_light"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/mod_source_imageview"
            app:layout_constraintStart_toEndOf="@+id/mod_thumbnail_imageview"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Sodium" />

        <!-- Subtext: Author + Downloads (muted gray) -->
        <TextView
            android:id="@+id/mod_info_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary_dim"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="@id/mod_title_textview"
            app:layout_constraintStart_toStartOf="@+id/mod_title_textview"
            app:layout_constraintTop_toBottomOf="@+id/mod_title_textview"
            tools:text="by jellysquid3 • 5M Downloads" />

        <!-- Short description (max 2 lines, ellipsis) -->
        <TextView
            android:id="@+id/mod_body_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary_dim"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/mod_title_textview"
            app:layout_constraintTop_toBottomOf="@+id/mod_info_textview"
            tools:text="Modern rendering engine and graphical optimizations for Minecraft. Sodium is a free and open-source rendering engine replacement." />

        <!-- Source badge (Modrinth/CurseForge) -->
        <ImageView
            android:id="@+id/mod_source_imageview"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_modrinth" />

        <!-- Status Chip (e.g. INSTALLED) -->
        <TextView
            android:id="@+id/mod_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nav_item_active"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="INSTALLED"
            android:textColor="@color/neon_green"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mod_thumbnail_imageview"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
