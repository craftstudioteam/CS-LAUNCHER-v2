<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#1A1A1A"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btn_features_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Optix Client"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Flipper for Transition between Content and Progress -->
            <ViewFlipper
                android:id="@+id/flipper_features_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- PAGE 1: Main Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Hero Card -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">

                        <!-- Glowing expanding pulse ring -->
                        <View
                            android:id="@+id/hero_glow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_active_glass_card"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/card_hero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_glass_card"
                            android:padding="20dp"
                            android:gravity="center_vertical">

                            <!-- Glowing Star Logo -->
                            <FrameLayout
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_fabric_logo_circle">

                                <ImageView
                                    android:id="@+id/iv_hero_logo"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_optix_logo"
                                    android:scaleType="fitCenter" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Optix Client"
                                    android:textColor="#FFFFFF"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_hero_version"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Version: --"
                                    android:textColor="#9CA3AF"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tv_hero_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="NOT INSTALLED"
                                    android:textColor="#FF6B6B"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.05" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Feature Cards (Grid-like) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FEATURES"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <!-- Grid Layout for 4 features -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:layout_marginBottom="20dp"
                        android:alignmentMode="alignBounds">

                        <!-- Card 1 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_glass_card"
                            android:padding="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ FPS Boost"
                                android:textColor="#39FF14"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Optimized rendering pipelines."
                                android:textColor="#9CA3AF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Card 2 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_glass_card"
                            android:padding="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Better Rendering"
                                android:textColor="#39FF14"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="High fidelity shaders support."
                                android:textColor="#9CA3AF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Card 3 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_glass_card"
                            android:padding="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Optimized Settings"
                                android:textColor="#39FF14"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Auto-configured configs."
                                android:textColor="#9CA3AF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Card 4 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_glass_card"
                            android:padding="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Client Features"
                                android:textColor="#39FF14"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Integrated skin manager."
                                android:textColor="#9CA3AF"
                                android:textSize="10sp" />
                        </LinearLayout>

                    </GridLayout>

                    <!-- Available Versions -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVAILABLE VERSIONS"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_features_versions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                </LinearLayout>

                <!-- PAGE 2: Transition & Installation Progress -->
                <LinearLayout
                    android:id="@+id/layout_features_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="48dp">

                    <FrameLayout
                        android:id="@+id/progress_logo_container"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginBottom="24dp">

                        <View
                            android:id="@+id/progress_pulse_ring"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:background="@drawable/bg_fabric_logo_circle"
                            android:alpha="0" />

                        <ImageView
                            android:id="@+id/iv_progress_logo"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_optix_logo"
                            android:scaleType="fitCenter" />

                        <ImageView
                            android:id="@+id/iv_progress_check"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check"
                            android:scaleType="fitCenter"
                            app:tint="#39FF14"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_progress_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Installing Client Features..."
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_progress_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preparing Profile..."
                        android:textColor="#9CA3AF"
                        android:textSize="13sp"
                        android:layout_marginBottom="20dp" />

                    <ProgressBar
                        android:id="@+id/pb_features_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_fabric_progress_horizontal" />

                </LinearLayout>

            </ViewFlipper>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
