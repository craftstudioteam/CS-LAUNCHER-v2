<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true"
    android:scrollbarThumbVertical="#00FF41"
    android:scrollbarSize="3dp"
    android:fadeScrollbars="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/setup_hub_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp"
        android:orientation="vertical"
        android:animateLayoutChanges="true">

        <!-- ═══ TOP HEADER ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_header_card"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="4dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_neon_indicator"
                android:layout_marginEnd="14dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/setup_hub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Profile"
                    android:textColor="#00FF41"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose how you want to play"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ SECTION 1: Vanilla Releases ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_neon_dot"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/section_vanilla_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/create_profile_vanilla_like_versions"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:textColor="#00FF41"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="2"
                android:layout_marginStart="12dp"
                android:background="@drawable/divider_neon_fade"/>
        </LinearLayout>

        <com.kdt.mcgui.MineButton
            android:id="@+id/vanilla_profile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/create_profile_vanilla"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_profile_button"
            android:stateListAnimator="@null"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/optifine_profile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="@string/create_profile_optifine"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_profile_button"
            android:stateListAnimator="@null"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

        <!-- ═══ SECTION 2: Mod Loaders ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_neon_dot"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/section_modloaders_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/create_profile_modded_versions"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:textColor="#00FF41"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="2"
                android:layout_marginStart="12dp"
                android:background="@drawable/divider_neon_fade"/>
        </LinearLayout>

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_fabric"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/modloader_dl_install_fabric"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_profile_button"
            android:stateListAnimator="@null"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_quilt"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="@string/modloader_dl_install_quilt"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_profile_button"
            android:stateListAnimator="@null"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_forge"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="@string/modloader_dl_install_forge"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_profile_button"
            android:stateListAnimator="@null"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_neoforge"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="@string/modloader_dl_install_neoforge"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_profile_button"
            android:stateListAnimator="@null"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

        <!-- ═══ SECTION 3: Online Modpacks Library ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_neon_dot"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/section_modpacks_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/modpack_install_button"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:textColor="#00FF41"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="2"
                android:layout_marginStart="12dp"
                android:background="@drawable/divider_neon_fade"/>
        </LinearLayout>

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_modpack"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/modpack_install_button"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_profile_button_highlight"
            android:stateListAnimator="@null"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/modded_profile_bta"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="@string/create_bta_profile"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_profile_button"
            android:stateListAnimator="@null"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

    </LinearLayout>
</com.kdt.DefocusableScrollView>
