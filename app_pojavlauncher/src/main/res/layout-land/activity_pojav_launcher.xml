<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark">

    <!-- ══════════════ TOP HEADER BAR ══════════════ -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_56sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_8sdp"
        android:background="@drawable/bg_header_bar"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CS Logo (top-left) — swap with your actual logo image -->
        <ImageView
            android:id="@+id/iv_cs_logo"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:src="@drawable/ic_cs_logo_placeholder"
            android:scaleType="fitCenter"
            android:contentDescription="CS Logo" />

        <!-- Launcher Title block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_10sdp">

            <!-- "CS LAUNCHER v2" -->
            <TextView
                android:id="@+id/tv_launcher_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_launcher_title"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_white"
                android:letterSpacing="0.04" />

            <!-- "YOUR MINECRAFT. YOUR WAY." -->
            <TextView
                android:id="@+id/tv_launcher_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_launcher_subtitle"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/accent_green"
                android:textAllCaps="true"
                android:letterSpacing="0.06" />

        </LinearLayout>

        <!-- Account Spinner (Microsoft Account) -->
        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="@dimen/_160sdp"
            android:layout_height="@dimen/_40sdp"
            android:dropDownWidth="wrap_content"
            android:dropDownVerticalOffset="@dimen/_42sdp"
            android:background="@drawable/bg_account_spinner"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_8sdp" />

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/bg_settings_btn"
            android:src="@drawable/ic_menu_settings"
            android:scaleType="center"
            android:contentDescription="Settings"
            android:elevation="2dp" />

    </LinearLayout>

    <!-- ══════════════ FRAGMENT CONTAINER (fills space between header and progress) ══════════════ -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/header_bar"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout" />

    <!-- ══════════════ PROGRESS BAR ══════════════ -->
    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>