<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark">

    <!-- ══════════════════════════════════════════════
         SINGLE COMPACT TOP BAR (Brand + Nav + Profile + Search overlay)
    ══════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/top_combined_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:background="@color/bg_header"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Background layer: horizontal layout of brand, nav tabs, spacer, profile -->
        <LinearLayout
            android:id="@+id/top_bar_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Brand title -->
            <TextView
                android:id="@+id/brand_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_launcher_title"
                android:textColor="@color/neon_green"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/_10sdp" />

            <!-- Nav tabs container (horizontal icon row) -->
            <LinearLayout
                android:id="@+id/nav_tabs_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginStart="@dimen/_6sdp">

                <!-- Home -->
                <FrameLayout
                    android:id="@+id/nav_home"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/nav_home_icon"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:src="@drawable/ic_home"
                            android:contentDescription="@string/mcl_tab_home" />

                        <View
                            android:id="@+id/nav_home_indicator"
                            android:layout_width="14dp"
                            android:layout_height="2dp"
                            android:background="@color/neon_green"
                            android:visibility="visible" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Download Mods -->
                <FrameLayout
                    android:id="@+id/nav_mod_store"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/nav_mod_store_icon"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:src="@drawable/ic_download_box"
                            android:contentDescription="@string/mcl_button_mod_store" />

                        <View
                            android:id="@+id/nav_mod_store_indicator"
                            android:layout_width="14dp"
                            android:layout_height="2dp"
                            android:background="@color/neon_green"
                            android:visibility="invisible" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Custom Controls -->
                <FrameLayout
                    android:id="@+id/nav_custom_controls"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/nav_controls_icon"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:src="@drawable/ic_menu_custom_controls"
                            android:contentDescription="@string/mcl_option_customcontrol" />

                        <View
                            android:id="@+id/nav_controls_indicator"
                            android:layout_width="14dp"
                            android:layout_height="2dp"
                            android:background="@color/neon_green"
                            android:visibility="invisible" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Cursor -->
                <FrameLayout
                    android:id="@+id/nav_cursor"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/nav_cursor_icon"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:src="@drawable/ic_mouse_pointer"
                            android:contentDescription="@string/cursor_customization_title" />

                        <View
                            android:id="@+id/nav_cursor_indicator"
                            android:layout_width="14dp"
                            android:layout_height="2dp"
                            android:background="@color/neon_green"
                            android:visibility="invisible" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Instance Tools -->
                <FrameLayout
                    android:id="@+id/nav_instance_tools"
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/nav_tools_icon"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:src="@drawable/ic_folder"
                            android:contentDescription="@string/main_install_jar_file" />

                        <View
                            android:id="@+id/nav_tools_indicator"
                            android:layout_width="14dp"
                            android:layout_height="2dp"
                            android:background="@color/neon_green"
                            android:visibility="invisible" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

            <!-- Spacer to push profile card to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Profile Card (right side) -->
            <LinearLayout
                android:id="@+id/profile_card"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_6sdp">

                <TextView
                    android:id="@+id/profile_welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_welcome_back_label"
                    android:textColor="@color/text_secondary_dim"
                    android:textSize="@dimen/_9ssp" />

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:text="@string/cs_welcome_username"
                    android:textColor="@color/text_primary_light"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/settings_gear"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_sharp_settings_24"
                    android:contentDescription="@string/mcl_button_settings"
                    app:tint="@color/text_secondary_light" />

            </LinearLayout>

        </LinearLayout>

        <!-- Overlay layer: Search field (hidden by default, fades in over the spacer area) -->
        <EditText
            android:id="@+id/top_search_field"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_50sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/background_card"
            android:hint="Search mods..."
            android:gravity="center_vertical"
            android:paddingStart="32dp"
            android:paddingEnd="@dimen/_8sdp"
            android:textColor="@color/text_primary_light"
            android:textColorHint="@color/text_secondary_dim"
            android:textSize="@dimen/_11ssp"
            android:alpha="0.0"
            android:visibility="gone"
            android:elevation="2dp" />

        <!-- Search icon inside the search field -->
        <ImageView
            android:id="@+id/top_search_icon"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_54sdp"
            android:src="@drawable/ic_search"
            android:alpha="0.0"
            android:visibility="gone"
            app:tint="@color/text_secondary_dim" />

    </FrameLayout>

    <!-- ══════════════════════════════════════════════
         RIGHT PANE — Full remaining space (below top bar, above bottom bar)
    ══════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/right_pane_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/top_combined_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fragments inflated here -->

    </FrameLayout>

    <!-- ══════════════════════════════════════════════
         BOTTOM BAR — Version spinner | Edit | PLAY
    ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Version icon -->
        <ImageView
            android:id="@+id/iv_version_icon"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:src="@drawable/ic_mc_block"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:contentDescription="Version" />

        <!-- Version Spinner -->
        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:background="@android:color/transparent"
            android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndPadding="@dimen/_4sdp"
            app:drawableEndSize="@dimen/_12sdp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="0dp" />

        <!-- Edit button -->
        <LinearLayout
            android:id="@+id/edit_profile_container"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_edit_profile"
                android:scaleType="fitCenter"
                android:contentDescription="@string/mcl_edit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mcl_edit"
                android:textSize="@dimen/_8ssp"
                android:textColor="@color/text_secondary_light" />

        </LinearLayout>

        <!-- PLAY button -->
        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_4sdp"
            android:text="@string/main_play"
            android:textAllCaps="true" />

    </LinearLayout>

    <!-- Hidden stubs for old IDs (back-compat) -->
    <View android:id="@+id/home_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/mod_store_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/custom_control_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/cursor_customization_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/pane_divider" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
