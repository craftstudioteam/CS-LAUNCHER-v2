<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_launcher.xml (Landscape)
    ─────────────────────────────────
    Full-screen layout with horizontal top navigation rail.
    - Left sidebar removed.
    - Top brand row + icon tabs.
    - Right pane (full remaining width).
    - Bottom bar (version spinner | Edit | PLAY).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark">

    <!-- ══════════════════════════════════════════════
         TOP BRANDING ROW
    ══════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_branding_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:background="@color/bg_header"
        app:layout_constraintTop_toTopOf="parent">

        <!-- CS Launcher Title -->
        <TextView
            android:id="@+id/brand_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:text="@string/cs_launcher_title"
            android:textColor="@color/neon_green"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/brand_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:text="@string/cs_launcher_subtitle"
            android:textColor="@color/text_secondary_dim"
            android:textSize="@dimen/_9ssp"
            android:layout_marginBottom="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/brand_title"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Spacer -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/brand_barrier"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:barrierDirection="end"
            app:constraint_referenced_ids="brand_title,brand_subtitle" />

        <!-- Search Field (hidden by default, revealed in State B) -->
        <EditText
            android:id="@+id/top_search_field"
            android:layout_width="0dp"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/background_card"
            android:hint="Search mods..."
            android:paddingStart="36dp"
            android:paddingEnd="@dimen/_10sdp"
            android:gravity="center_vertical"
            android:textColor="@color/text_primary_light"
            android:textColorHint="@color/text_secondary_dim"
            android:textSize="@dimen/_12ssp"
            android:alpha="0.0"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/profile_card"
            app:layout_constraintStart_toEndOf="@id/brand_subtitle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_weight="1" />

        <!-- Search icon inside field -->
        <ImageView
            android:id="@+id/top_search_icon"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:src="@drawable/ic_search"
            android:alpha="0.0"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/top_search_field"
            app:layout_constraintStart_toStartOf="@id/top_search_field"
            app:layout_constraintTop_toTopOf="@id/top_search_field"
            app:tint="@color/text_secondary_dim" />

        <!-- Profile Card (right-aligned default, slides left in State B) -->
        <LinearLayout
            android:id="@+id/profile_card"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_welcome_back_label"
                android:textColor="@color/text_secondary_dim"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="@string/cs_welcome_username"
                android:textColor="@color/text_primary_light"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />

            <!-- Settings gear -->
            <ImageButton
                android:id="@+id/settings_gear"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sharp_settings_24"
                android:contentDescription="@string/mcl_button_settings"
                app:tint="@color/text_secondary_light" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════════════
         HORIZONTAL NAVIGATION RAIL (Icon Tabs)
    ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/nav_rail"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/bg_header"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/top_branding_row">

        <!-- Home -->
        <FrameLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_home_icon"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:src="@drawable/ic_home"
                    android:contentDescription="Home" />

                <View
                    android:id="@+id/nav_home_indicator"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="2dp"
                    android:background="@color/neon_green"
                    android:visibility="visible" />

            </LinearLayout>

        </FrameLayout>

        <!-- Download Mods -->
        <FrameLayout
            android:id="@+id/nav_mod_store"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_mod_store_icon"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:src="@drawable/ic_add"
                    android:contentDescription="Mod Store" />

                <View
                    android:id="@+id/nav_mod_store_indicator"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="2dp"
                    android:background="@color/neon_green"
                    android:visibility="invisible" />

            </LinearLayout>

        </FrameLayout>

        <!-- Custom Controls -->
        <FrameLayout
            android:id="@+id/nav_custom_controls"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_controls_icon"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:src="@drawable/ic_menu_custom_controls"
                    android:contentDescription="Custom Controls" />

                <View
                    android:id="@+id/nav_controls_indicator"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="2dp"
                    android:background="@color/neon_green"
                    android:visibility="invisible" />

            </LinearLayout>

        </FrameLayout>

        <!-- Cursor -->
        <FrameLayout
            android:id="@+id/nav_cursor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_cursor_icon"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:src="@drawable/ic_mouse_pointer"
                    android:contentDescription="Cursor" />

                <View
                    android:id="@+id/nav_cursor_indicator"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="2dp"
                    android:background="@color/neon_green"
                    android:visibility="invisible" />

            </LinearLayout>

        </FrameLayout>

        <!-- Instance Tools -->
        <FrameLayout
            android:id="@+id/nav_instance_tools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_tools_icon"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:src="@drawable/ic_folder"
                    android:contentDescription="Tools" />

                <View
                    android:id="@+id/nav_tools_indicator"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="2dp"
                    android:background="@color/neon_green"
                    android:visibility="invisible" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════════════
         RIGHT PANE — Full remaining width
    ══════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/right_pane_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/nav_rail"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fragments inflated here -->

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════════════
         BOTTOM BAR — Version spinner | Edit | PLAY
    ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_54sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Minecraft block icon -->
        <ImageView
            android:id="@+id/iv_version_icon"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:src="@drawable/ic_mc_block"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:contentDescription="Version icon" />

        <!-- Version Spinner -->
        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:background="@android:color/transparent"
            android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndPadding="@dimen/_4sdp"
            app:drawableEndSize="@dimen/_12sdp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="0dp" />

        <!-- Edit button -->
        <LinearLayout
            android:id="@+id/edit_profile_container"
            android:layout_width="@dimen/_52sdp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_edit_profile"
                android:scaleType="fitCenter"
                android:contentDescription="Edit profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mcl_edit"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/text_secondary_light" />

        </LinearLayout>

        <!-- PLAY button -->
        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="@dimen/_130sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_4sdp"
            android:text="@string/main_play"
            android:textAllCaps="true" />

    </LinearLayout>

    <!-- Hidden sidebar views kept for back-compat (references removed) -->
    <View
        android:id="@+id/home_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/mod_store_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/custom_control_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/cursor_customization_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/pane_divider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
