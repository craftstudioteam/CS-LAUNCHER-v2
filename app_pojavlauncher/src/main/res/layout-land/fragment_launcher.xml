<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_launcher.xml
    ─────────────────────
    Horizontal two-pane layout — pixel-accurate match to CS Launcher v2 design:
      LEFT  (33%) : Sidebar nav — Home (active), Mod Store, Custom Controls,
                    ── INSTANCE TOOLS ──, Manage Mods, Open Directory,
                    Install .jar File, Share Logs
      RIGHT (67%) : Hero banner (bg image + CS logo + welcome text)
                    + Bottom bar (version spinner | Edit | PLAY)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark">

    <!-- Guideline: 33 % left / 67 % right -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/pane_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33" />

    <!-- ══════════════════════════════════════════════
         LEFT SIDEBAR
    ══════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/left_sidebar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:background="@color/bg_sidebar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pane_divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_16sdp">

            <!-- ── HOME (Active / highlighted) ── -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/home_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:drawableStart="@drawable/ic_home"
                android:text="@string/mcl_tab_home"
                android:textColor="@color/text_secondary_light" />

            <!-- ── MOD STORE ── -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/mod_store_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:drawableStart="@drawable/ic_add"
                android:text="@string/mcl_button_mod_store" />

            <!-- ── CUSTOM CONTROLS ── -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:drawableStart="@drawable/ic_menu_custom_controls"
                android:text="@string/mcl_option_customcontrol" />

            <!-- ── CURSOR CUSTOMIZATION ── -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/cursor_customization_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:drawableStart="@drawable/ic_mouse_pointer"
                android:text="@string/cursor_customization_title" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:background="@color/divider_color" />

            <!-- ── INSTANCE TOOLS label ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mcl_section_instance_tools"
                android:textAllCaps="true"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/text_secondary_dim"
                android:letterSpacing="0.10"
                android:paddingStart="@dimen/_14sdp"
                android:paddingEnd="@dimen/_14sdp"
                android:paddingTop="@dimen/_6sdp"
                android:paddingBottom="@dimen/_4sdp" />

            <!-- ── OPEN DIRECTORY ── -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_directory_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:drawableStart="@drawable/ic_folder"
                android:text="@string/mcl_button_open_directory" />

            <!-- ── INSTALL .JAR FILE ── -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:drawableStart="@drawable/ic_menu_install_jar"
                android:text="@string/main_install_jar_file" />

            <!-- ── SHARE LOGS ── -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:drawableStart="@android:drawable/ic_menu_share"
                android:text="@string/main_share_logs" />

            <!-- Hidden stubs — IDs preserved for back-compat -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/settings_menu_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_sharp_settings_24"
                android:text="@string/mcl_button_settings"
                android:visibility="gone" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_menu_news"
                android:text="@string/mcl_tab_wiki"
                android:visibility="gone" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/discord_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_discord"
                android:text="@string/mcl_button_discord"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Thin vertical divider between panes -->
    <View
        android:id="@+id/pane_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/divider_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/pane_guideline"
        app:layout_constraintEnd_toStartOf="@id/pane_guideline" />

    <!-- ══════════════════════════════════════════════
         RIGHT PANE — Hero banner + bottom action bar
    ══════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/right_pane_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:clipToOutline="true"
        android:background="@drawable/bg_right_pane"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toEndOf="@id/pane_divider"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fragments (e.g. RightPaneHomeFragment) will be inflated here -->

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════════════
         BOTTOM BAR — Version spinner | Edit | PLAY
    ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_54sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_bar"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/pane_divider"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Invisible bg stub — back-compat -->
        <View
            android:id="@+id/_background_display_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Minecraft block icon for version -->
        <ImageView
            android:id="@+id/iv_version_icon"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:src="@drawable/ic_mc_block"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:contentDescription="Version icon" />

        <!-- Version Spinner (1.20.1 – Forge / Custom Profile) -->
        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:background="@android:color/transparent"
            android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndPadding="@dimen/_4sdp"
            app:drawableEndSize="@dimen/_12sdp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="0dp" />

        <!-- Edit / pencil button -->
        <LinearLayout
            android:id="@+id/edit_profile_container"
            android:layout_width="@dimen/_52sdp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:background="?android:attr/selectableItemBackground">

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_edit_profile"
                android:scaleType="fitCenter"
                android:contentDescription="Edit profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mcl_edit"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/text_secondary_light" />

        </LinearLayout>

        <!-- PLAY button (Updated theme) -->
        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="@dimen/_130sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_4sdp"
            android:text="@string/main_play"
            android:textAllCaps="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>